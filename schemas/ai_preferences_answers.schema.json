{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_preferences.md Answer Schema",
  "description": "All possible answer fields for the ai_preferences.md interview.",
  "type": "object",
  "properties": {
    "tone": {"type": "string", "description": "Preferred AI communication tone"},
    "verbosity": {"type": "string", "description": "Preferred response detail level"},
    "explain_reasoning": {"type": "string", "description": "When to explain code reasoning"},
    "clarification_policy": {"type": "string", "description": "Ask clarifying questions or assume"},
    "comments_policy": {"type": "string", "description": "When to add code comments"},
    "error_handling": {"type": "string", "description": "Preferred error handling style"},
    "test_policy": {"type": "string", "description": "When to write tests"},
    "formatting_preferences": {"type": "string", "description": "Code formatting preferences"},
    "naming_conventions": {"type": "string", "description": "Naming convention preferences"},
    "design_patterns": {"type": "string", "description": "Preferred design patterns"},
    "stack_preferences": {"type": "string", "description": "Preferred/avoided languages and frameworks"},
    "approach": {"type": "string", "description": "Plan-first vs code-first"},
    "iteration_style": {"type": "string", "description": "Incremental vs big-bang"},
    "file_editing": {"type": "string", "description": "Edit directly vs show first"},
    "git_policy": {"type": "string", "description": "How AI handles git"},
    "documentation_policy": {"type": "string", "description": "When to update docs"},
    "scope_policy": {"type": "string", "description": "Scope of AI suggestions"},
    "secrets_policy": {"type": "string", "description": "How AI handles secrets"},
    "external_services_policy": {"type": "string", "description": "Can AI suggest external services"},
    "no_touch_files": {"type": "string", "description": "Files AI should never touch (optional)"},
    "breaking_changes_tolerance": {"type": "string", "description": "Tolerance for breaking changes"},
    "dependencies_policy": {"type": "string", "description": "Can AI add new dependencies"},
    "cost_sensitivity": {"type": "string", "description": "Sensitivity to API costs"},
    "pet_peeves": {"type": "string", "description": "Things AI does that annoy you (optional)"},
    "past_frustrations": {"type": "string", "description": "Bad AI experiences (optional)"},
    "must_haves": {"type": "string", "description": "Non-negotiable requirements (optional)"},
    "never_do": {"type": "string", "description": "What AI must never do (optional)"}
  },
  "required": ["tone", "verbosity", "test_policy", "secrets_policy"]
}
